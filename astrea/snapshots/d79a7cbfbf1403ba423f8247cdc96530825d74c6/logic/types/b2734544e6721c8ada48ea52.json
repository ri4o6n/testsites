{"csharp":"using System;\nusing NaughtyAttributes;\nusing UnityEngine;\n\nnamespace Astrea;\n\n[CreateAssetMenu(fileName = \"ClearingReward\", menuName = \"Data/Rewards/ClearingReward\", order = 0)]\npublic class ClearingReward : ScriptableObject\n{\n\t[Header(\"Rewards\")]\n\t[SerializeField]\n\tprotected Reward[] rewards;\n\n\t[SerializeField]\n\tprivate NodeViewData data;\n\n\t[Header(\"Prefab\")]\n\t[SerializeField]\n\tprotected bool enableRewardPropPrefab;\n\n\t[SerializeField]\n\t[ShowIf(\"enableRewardPropPrefab\")]\n\tprivate GameObject rewardPropPrefab;\n\n\t[SerializeField]\n\tprivate bool dontGoToBattleScene;\n\n\t[NonSerialized]\n\t[ShowNonSerializedField]\n\tprivate int rewardsCounter;\n\n\tpublic Reward[] Rewards => GetRewards();\n\n\tpublic NodeViewData Data => data;\n\n\tpublic bool DontGoToBattleScene => dontGoToBattleScene;\n\n\tpublic int RewardsCounter => rewardsCounter;\n\n\tprotected virtual Reward[] GetRewards()\n\t{\n\t\treturn rewards;\n\t}\n\n\tpublic void SetRewards(Reward[] rewards)\n\t{\n\t\tthis.rewards = rewards;\n\t}\n\n\tpublic void InstantiatePropPrefab()\n\t{\n\t\tif (enableRewardPropPrefab)\n\t\t{\n\t\t\tInitializePropPrefab(ReferenceSingleton<PoolHandler>.Instance.GetObject(rewardPropPrefab.name));\n\t\t}\n\t}\n\n\tprotected virtual void InitializePropPrefab(GameObject rewardPropGameObject)\n\t{\n\t}\n\n\tpublic void ResetRewardsCounter()\n\t{\n\t\trewardsCounter = 0;\n\t}\n\n\tpublic bool IsAnyRewardLeft()\n\t{\n\t\tif (rewardsCounter == GetRewards().Length)\n\t\t{\n\t\t\trewardsCounter = 0;\n\t\t\treturn false;\n\t\t}\n\t\treturn true;\n\t}\n\n\tpublic bool IsAnyRewardLeftWithoutResettingCounter()\n\t{\n\t\tif (rewardsCounter == GetRewards().Length)\n\t\t{\n\t\t\treturn false;\n\t\t}\n\t\treturn true;\n\t}\n\n\tpublic void GetReward()\n\t{\n\t\tGetRewards()[rewardsCounter].GetReward();\n\t}\n\n\tpublic void IncreaseRewardsCounter()\n\t{\n\t\trewardsCounter++;\n\t}\n\n\tpublic void DecreaseRewardsCounter()\n\t{\n\t\trewardsCounter--;\n\t}\n\n\tpublic Reward GetNextReward()\n\t{\n\t\tif (rewardsCounter > GetRewards().Length - 1)\n\t\t{\n\t\t\treturn null;\n\t\t}\n\t\treturn GetRewards()[rewardsCounter];\n\t}\n\n\tpublic Reward GetCurrentReward()\n\t{\n\t\treturn GetRewards()[rewardsCounter];\n\t}\n\n\tpublic Reward GetPreviousReward()\n\t{\n\t\tif (rewardsCounter - 1 < 0)\n\t\t{\n\t\t\treturn null;\n\t\t}\n\t\treturn GetRewards()[rewardsCounter - 1];\n\t}\n}\n","fields":[{"name":"rewards","signature":"061d129bbc"},{"name":"data","signature":"06128a58"},{"name":"enableRewardPropPrefab","signature":"0602"},{"name":"rewardPropPrefab","signature":"061265"},{"name":"dontGoToBattleScene","signature":"0602"},{"name":"rewardsCounter","signature":"0608"}],"id":"Astrea.ClearingReward","methods":[{"id":"Astrea.ClearingReward::get_Rewards#cc32:g0()->array<Astrea.Reward>","name":"get_Rewards","path":"methods/8c8f830792eb0be80ade6f2f.json","sha256":"8f2beb23d89921fa20b9a87d447146e0f88120ad78d03a60d6b8bdb5e168954e","token":100676406},{"id":"Astrea.ClearingReward::GetRewards#cc32:g0()->array<Astrea.Reward>","name":"GetRewards","path":"methods/2005892f79d3e8760ec88fe1.json","sha256":"7369e83a9469c4e41aebeb230203ee62fe10db83a77c7231b5064c5fc1241589","token":100676407},{"id":"Astrea.ClearingReward::SetRewards#cc32:g0(array<Astrea.Reward>)->void","name":"SetRewards","path":"methods/92c086cabdcb567d017f6eea.json","sha256":"4b4e12c4f7f1b0c9089b71157844d624098b555e0b3ca20259fa497f91e012b2","token":100676408},{"id":"Astrea.ClearingReward::get_Data#cc32:g0()->Astrea.NodeViewData","name":"get_Data","path":"methods/50aa9c51de86164978f50e3d.json","sha256":"50bd48f21ef6c21f49afb88bcf0109bf7187e51b12fd2b250266ac07cab0d313","token":100676409},{"id":"Astrea.ClearingReward::get_DontGoToBattleScene#cc32:g0()->bool","name":"get_DontGoToBattleScene","path":"methods/30670b6e4d3b6e6ff64f1d3b.json","sha256":"26c5eaa6095aec1fbef2c471fd38410d740efd6438e2d0eabb7813dff5006b24","token":100676410},{"id":"Astrea.ClearingReward::get_Rewa