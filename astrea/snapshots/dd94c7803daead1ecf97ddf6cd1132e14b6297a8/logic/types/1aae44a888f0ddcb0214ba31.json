{"csharp":"using System.Collections.Generic;\nusing Astrea.BattleActions;\nusing NaughtyAttributes;\nusing UnityEngine;\nusing UnityEngine.Localization.SmartFormat;\n\nnamespace Astrea.RunModifiers;\n\npublic class RunModifier : ScriptableObject\n{\n\t[Header(\"Data\")]\n\t[SerializeField]\n\tprivate string ID;\n\n\t[SerializeField]\n\t[ShowAssetPreview(64, 64)]\n\tprivate Sprite runModifierIcon;\n\n\t[SerializeField]\n\tprivate RunModifierType runModifierType;\n\n\t[SerializeField]\n\tprivate bool enableRunModifierVariableAmount;\n\n\t[SerializeField]\n\t[ShowIf(\"enableRunModifierVariableAmount\")]\n\tprotected int runModifierVariableAmount;\n\n\t[Header(\"Tags\")]\n\t[SerializeField]\n\tprivate Effect[] effects;\n\n\t[SerializeField]\n\tprivate Tag[] tags;\n\n\t[SerializeField]\n\tprivate ActionFaceForDescription[] actionFaceForDescriptions;\n\n\t[Header(\"To Mute Assets\")]\n\t[SerializeField]\n\tprivate List<string> diceToMute = new List<string>();\n\n\t[SerializeField]\n\tprivate List<OmenData> blessingsToMute = new List<OmenData>();\n\n\t[SerializeField]\n\tprivate List<RunModifier> runModifiersToMute = new List<RunModifier>();\n\n\t[SerializeField]\n\tprivate List<BattleAction> virtueActionsToMute = new List<BattleAction>();\n\n\t[SerializeField]\n\tprivate List<CustomEventSetup> eventsToMute = new List<CustomEventSetup>();\n\n\t[SerializeField]\n\tprivate bool hideDiceOnDailyRun;\n\n\t[SerializeField]\n\tprivate bool dailyRunOnly;\n\n\t[SerializeField]\n\tprivate bool runModifierOnly;\n\n\t[Header(\"Editor\")]\n\t[SerializeField]\n\tprivate bool mute;\n\n\tprotected string localizedDescription => localizationManager.GetLocalizedString(ID + \"_D\");\n\n\tpublic Sprite RunModifierIcon => runModifierIcon;\n\n\tpublic RunModifierType RunModifierType => runModifierType;\n\n\tpublic int RunModifierVariableAmount => runModifierVariableAmount;\n\n\tpublic Effect[] Effects => effects;\n\n\tpublic Tag[] Tags => tags;\n\n\tpublic ActionFaceForDescription[] ActionFaceF